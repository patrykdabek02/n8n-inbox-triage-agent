    {
      "parameters": {
        "jsCode": "const gmailTriggerRan = $('Gmail Trigger').isExecuted === true;\nconst sourceItems = gmailTriggerRan ? $('Gmail Trigger').all() : $('Get many messages').all();\nconst inputItems = $input.all();\n\nfor (let i = 0; i < inputItems.length; i++) {\n    const item = inputItems[i];\n    const raw = item.json.text || '';\n    let parsed = null;\n    try {\n          parsed = JSON.parse(raw);\n    } catch (e) {\n          const match = raw.match(/\\{[\\s\\S]*\\}/);\n          if (match) {\n                  try {\n                            parsed = JSON.parse(match[0]);\n                  } catch (e2) {\n                            parsed = null;\n                  }\n          }\n    }\n\n    if (parsed && parsed.category) {\n          item.json.category = parsed.category;\n          item.json.action = parsed.action || 'label';\n          item.json.reason = parsed.reason || '';\n    } else {\n          item.json.category = 'WAZNE';\n          item.json.action = 'label';\n          item.json.reason = 'Nie udalo sie sparsowac odpowiedzi modelu, oznaczono ostroznosciowo jako WAZNE. Surowa odpowiedz: ' + raw.slice(0, 200);\n    }\n\n    const src = sourceItems[i];\n    if (src && src.json) {\n          item.json.id = src.json.id;\n          item.json.threadId = src.json.threadId;\n    }\n}\n\nreturn inputItems;"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
